# =============================================================================
# SOLE E-commerce — Environment template
# Copy: cp .env.example .env
# Local dev defaults: Frontend http://localhost:3000 | API http://localhost:3001/api
# =============================================================================

# --- URLs ---
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- MongoDB ---
# Local Docker: docker compose up -d  (MongoDB :27017, Redis :6379, Redis UI :8082)
MONGODB_URI=mongodb://localhost:27017/sole_ecommerce
MONGODB_PORT=27017

# --- Redis ---
# BE connects here. Redis Commander (docker) must point to the SAME instance.
# If you run `brew services start redis` AND docker redis on :6379, Commander may show an empty DB.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms

# --- JWT ---
# Min 32 characters (256-bit) — required for JWT HS512
JWT_SECRET=sole-dev-jwt-secret-min-32-characters!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Auth cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=SOLE <onboarding@resend.dev>

# --- Cloudinary (backend upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SePay (mỗi merchant / dev tự đăng ký tài khoản riêng) ---
# Sandbox: https://sepay.vn → lấy Merchant ID + Secret Key
SEPAY_API_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_ENVIRONMENT=sandbox
# production: SEPAY_API_URL=https://pay.sepay.vn/v1/checkout/init  SEPAY_ENVIRONMENT=production
#
# IPN webhook — SePay gọi POST về BE khi thanh toán xong.
# Local dev: BE chạy localhost → cần ngrok HTTPS (xem README § SePay + ngrok).
# IPN auth trên Dashboard: loại SECRET_KEY — header X-Secret-Key = SEPAY_SECRET_KEY (phải trùng).
SEPAY_IPN_URL=http://localhost:3001/api/payments/sepay/callback
# Sau khi chạy ./scripts/ngrok-sepay.sh --url, cập nhật Dashboard + (tuỳ chọn) dòng trên:
# SEPAY_IPN_URL=https://<subdomain>.ngrok-free.app/api/payments/sepay/callback
SEPAY_IPN_VERIFY=true
# Chỉ debug tạm (KHÔNG production): SEPAY_IPN_VERIFY=false

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_TOOL_LOOP=4
OPENAI_STRUCTURED_OUTPUT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# AI image processing
AI_IMAGE_WEBP_QUALITY=85
AI_IMAGE_MAX_INPUT_BYTES=10485760
AI_IMAGE_MAX_DIMENSION=4096

# Rate limits (AI endpoints)
RATE_LIMIT_AI_CHAT_MAX=30
RATE_LIMIT_AI_VOICE_MAX=10
RATE_LIMIT_AI_IMAGE_MAX=10

# AI retrieval (legacy embedding index on startup)
AI_RETRIEVAL_PRODUCT_TOP_K=5
AI_RETRIEVAL_POLICY_TOP_K=2

# --- Frontend (Vite — loaded from project root) ---
# VITE_GOOGLE_CLIENT_ID should match GOOGLE_CLIENT_ID
VITE_API_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Docker Compose (optional) ---
BACKEND_PORT=3001
BACKEND_INTERNAL_PORT=8081
FRONTEND_PORT=3000
FRONTEND_INTERNAL_PORT=5173
REDIS_COMMANDER_PORT=8082
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# --- Logging (optional) ---
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Catalog seed ---
CATALOG_SEED_ENABLED=true
# true = refresh demo image URLs on every BE start when products already exist
CATALOG_SEED_FORCE=false

# --- Review seed ---
REVIEW_SEED_ENABLED=true
REVIEW_SEED_FORCE=false

# --- Shipping ---
SHIPPING_FLAT_FEE=30000
SHIPPING_FREE_THRESHOLD=2000000
VAT_RATE=0

# --- RBAC (set true on staging/production) ---
permission.enforcement=true
# Hoặc dùng: PERMISSION_ENFORCEMENT=true

# --- Spring profile: prod disables public Swagger ---
# SPRING_PROFILES_ACTIVE=prod

# --- User seed (demo login accounts) ---
USER_SEED_ENABLED=true
USER_SEED_PASSWORD=Sole@123
