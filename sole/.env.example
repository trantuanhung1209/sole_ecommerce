# =============================================================================
# SOLE E-commerce — VPS Production Docker Compose Environment Template
#
# Quick start on VPS (run inside the sole/ folder):
#   1. cp .env.example .env
#   2. Fill in JWT_SECRET, FRONTEND_BASE_URL, CORS_ALLOWED_ORIGINS, and SEPAY_*
#   3. docker compose pull
#   4. docker compose up -d
# =============================================================================

# --- Docker Hub Image Coordinates ---
DOCKERHUB_USER=trantuanhung1209
IMAGE_TAG=latest
FRONTEND_PORT=80

# --- Spring Profile & Security ---
# "prod" disables Swagger UI, forces permission.enforcement=true, and requires
# SEPAY_ENVIRONMENT=production + non-blank SEPAY_SECRET_KEY + SEPAY_IPN_VERIFY=true.
#
# Plain HTTP VPS IP testing note:
#   If you are temporarily testing over plain http://<VPS_IP> (without HTTPS),
#   set:
#     COOKIE_SECURE=false
#     SPRING_PROFILES_ACTIVE=docker
#     PERMISSION_ENFORCEMENT=true
#   (and update FRONTEND_BASE_URL / CORS_ALLOWED_ORIGINS to http://<VPS_IP>)
SPRING_PROFILES_ACTIVE=prod
PERMISSION_ENFORCEMENT=true

# --- Domain / URLs (HTTPS production defaults) ---
FRONTEND_BASE_URL=https://sole.uside.id.vn
CORS_ALLOWED_ORIGINS=https://sole.uside.id.vn

# --- Auth Cookies ---
# Keep COOKIE_SECURE=true behind HTTPS (Caddy / Nginx / Cloudflare).
# Leave COOKIE_DOMAIN empty unless sharing cookies across subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# --- JWT (REQUIRED — replace with a random >= 32-char secret for HS512) ---
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- SePay Payment Gateway (REQUIRED when SPRING_PROFILES_ACTIVE=prod) ---
# Production checkout endpoint: https://pay.sepay.vn/v1/checkout/init
# Sandbox checkout endpoint:    https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_API_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_ENVIRONMENT=production
SEPAY_IPN_VERIFY=true
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=replace-with-your-sepay-secret-key
SEPAY_IPN_URL=https://sole.uside.id.vn/api/payments/sepay/callback

# --- Initial Database Seed (MongoDB) ---
# First boot seeds 28 products, 28 reviews, 10 demo users, 20 orders, 14 coupons, etc.
# IMPORTANT: After verifying the initial seed in production, flip
# USER_SEED_ENABLED=false and DEMO_OPS_SEED_ENABLED=false (or change
# USER_SEED_PASSWORD) so demo credentials cannot be recreated/reused in prod.
CATALOG_SEED_ENABLED=true
CATALOG_SEED_FORCE=false
REVIEW_SEED_ENABLED=true
REVIEW_SEED_FORCE=false
USER_SEED_ENABLED=true
DEMO_OPS_SEED_ENABLED=true
USER_SEED_PASSWORD=Sole@123

# --- Optional Integrations ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_TOOL_LOOP=4
OPENAI_STRUCTURED_OUTPUT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=SOLE <onboarding@resend.dev>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Shipping & VAT ---
SHIPPING_FLAT_FEE=30000
SHIPPING_FREE_THRESHOLD=2000000
VAT_RATE=0

# --- Logging ---
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
